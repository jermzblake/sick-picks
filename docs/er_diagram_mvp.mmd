erDiagram
    LEAGUE ||--o{ SEASON : has
    LEAGUE ||--o{ TEAM : has
    SEASON ||--o{ GAME : has
    USER ||--o{ PICK : makes
    TEAM ||--o{ GAME : "home team"
    TEAM ||--o{ GAME : "away team"
    GAME ||--o{ GAME_LINE : has
    GAME ||--o{ PICK : receives
    TEAM ||--o{ PICK : "picked team"
    GAME_LINE ||--o{ PICK : "locks line"

    LEAGUE {
        bigint id PK
        string name
        string abbreviation
        string sport
    }

    SEASON {
        bigint id PK
        bigint league_id FK
        int year
    }

    USER {
        bigint id PK
        string username UK
        string email
        string display_name
        string password
        boolean is_active
        datetime date_joined
    }

    TEAM {
        bigint id PK
        bigint league_id FK
        string external_id UK
        string name
        string abbreviation
    }

    GAME {
        bigint id PK
        string external_id UK
        bigint season_id FK
        int week
        bigint home_team_id FK
        bigint away_team_id FK
        datetime kickoff_at
        string status
        int home_score
        int away_score
        datetime created_at
        datetime updated_at
    }

    GAME_LINE {
        bigint id PK
        bigint game_id FK
        string source
        string bookmaker
        decimal home_spread
        decimal away_spread
        decimal home_spread_price
        decimal away_spread_price
        decimal home_moneyline
        decimal away_moneyline
        datetime captured_at
    }

    PICK {
        bigint id PK
        bigint user_id FK
        bigint game_id FK
        bigint game_line_id FK
        bigint picked_team_id FK
        string pick_type
        decimal line_value
        decimal price
        string result
        decimal points
        datetime submitted_at
    }